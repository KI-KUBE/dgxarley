# Managed by Ansible (rustfs_server) — do not edit. Contains secrets.
RUSTFS_ACCESS_KEY={{ rustfs_server_access_key }}
RUSTFS_SECRET_KEY={{ rustfs_server_secret_key }}
{% if rustfs_server_distributed | bool %}
{# Distributed erasure-coded cluster: RUSTFS_VOLUMES lists EVERY volume across
   ALL nodes and MUST be byte-identical on every node. Built from the structured
   rustfs_server_members (node -> disks[]); each node is reached on its QSFP IP
   (200GbE mesh), falling back to its k3s VLAN IP. Object dir on each disk =
   <mount>/rustfs. Order follows the list order (positional erasure membership). #}
{% set vols = [] %}
{% for e in rustfs_server_members %}
{%   set addr = hostvars[e.node].qsfp_ip | default(hostvars[e.node].k3s_node_ip) %}
{%   for d in e.disks %}
{%     set _ = vols.append('http://' ~ addr ~ ':' ~ rustfs_server_s3_port ~ d.path ~ '/rustfs') %}
{%   endfor %}
{% endfor %}
RUSTFS_VOLUMES={{ vols | join(' ') }}
{# Erasure config: set size = drives per set; EC:M = parity blocks (raid0/5/6). #}
RUSTFS_ERASURE_SET_DRIVE_COUNT={{ rustfs_server_set_drive_count }}
RUSTFS_STORAGE_CLASS_STANDARD=EC:{{ rustfs_server_parity }}
{% else %}
RUSTFS_VOLUMES={{ rustfs_server_data_dir }}
{% endif %}
RUSTFS_ADDRESS=0.0.0.0:{{ rustfs_server_s3_port }}
RUSTFS_CONSOLE_ENABLE={{ rustfs_server_console_enable | bool | lower }}
RUSTFS_CONSOLE_ADDRESS=0.0.0.0:{{ rustfs_server_console_port }}
