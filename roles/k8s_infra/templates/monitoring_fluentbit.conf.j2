##
## Fluent Bit — Loki log collector (DaemonSet in ns `loki`)
## Rendered by roles/k8s_infra/tasks/monitoring/loki.yml into ConfigMap
## `fluent-bit-config`. Knobs: fluentbit_* in defaults/main/monitoring.yml.
##
## Replaces promtail, EOL since 2026-03-02. The design target is the label set
## Loki ACTUALLY has today, read live from /loki/api/v1/labels rather than off
## the promtail config — that is how the `stream` label was caught: promtail's
## `cri:` pipeline stage exports stdout/stderr as a label and nothing in
## promtail.yaml says so.
##

[SERVICE]
    Flush                     5
    Log_Level                 info
    # /api/v1/metrics/prometheus, scraped via the pod annotations set on the
    # DaemonSet. promtail had no metrics wiring at all.
    HTTP_Server               On
    HTTP_Listen               0.0.0.0
    HTTP_Port                 2020
    # Buffering lives on the hostPath so a pod restart does not drop queued
    # chunks. storage.max_chunks_up caps how much of that backlog is held in
    # memory at once — with storage.type filesystem on the input this REPLACES
    # Mem_Buf_Limit, which is why no Mem_Buf_Limit is set below.
    storage.path              /var/log/flb-storage/
    storage.sync              normal
    storage.max_chunks_up     64
    storage.backlog.mem_limit 64M

[INPUT]
    Name              tail
    Tag               kube.*
    Path              /var/log/containers/*.log
    # Without this fluent-bit tails its own container log and amplifies every
    # one of its own error lines back into itself.
    Exclude_Path      /var/log/containers/fluent-bit-daemonset-*_loki_*.log
    # Equivalent of promtail's `pipeline_stages: [cri: {}]` — it rejoins the
    # P/F partial lines the runtime splits at 16 KB. Without it long SGLang
    # tracebacks arrive shredded, which short-line testing never reveals.
    # BUILT-IN parser (not from parsers.conf); it also supplies log/stream/time,
    # so no separate `Parser cri` is needed.
    multiline.parser  cri
    # Read positions. promtail kept these in an ephemeral /tmp inside the pod
    # and re-read from scratch on every restart; this DB lives on the host.
    DB                /var/log/flb_kube.db
    DB.locking        true
    storage.type      filesystem
    Skip_Long_Lines   On
    Refresh_Interval  10
    # read_from_head stays at its default (off): at cutover fluent-bit starts at
    # the tail of each file instead of replaying history that Loki would reject
    # anyway (reject_old_samples_max_age: 168h).

{% if fluentbit_systemd_enabled | default(false) | bool %}
##
## systemd/journal input — SEPARATELY GATED, off by default.
##
## Closes a gap that promtail never covered either: kernel and unit logs never
## reached Loki, only container stdout/stderr did. Verified on 2026-08-01 that
## no journal-sourced stream has ever existed (all `job` values in Loki have the
## <namespace>/<pod> form, and no `unit`/`syslog_identifier`/`boot_id` label
## exists). Enabling this therefore ADDS streams by design — keep it OFF while
## running the collector parity check in FLUENTBIT_VALIDATE.md.
##
## Notably this is the only way `journalctl -t ulogd` (the kube-router
## NetworkPolicy drops, now that policies are enforced) and anything arriving
## via rsyslog's omjournal forward (haproxy) becomes queryable centrally.
##
[INPUT]
    Name              systemd
    Tag               host.*
    # `Path` deliberately UNSET: libsystemd then opens the DEFAULT journal,
    # covering BOTH /var/log/journal (persistent) and /run/log/journal
    # (volatile). Measured 2026-08-01: k3smaster and spark1 both store
    # PERSISTENTLY (3.8 GB / 640 MB), /run/log/journal exists but is empty.
    # spark2-4 were powered off and are assumed identical, so leaving Path unset
    # keeps it correct either way. The DaemonSet mounts both paths, plus
    # /etc/machine-id which libsystemd needs to open the journal at all.
{% for unit in fluentbit_systemd_units | default([]) %}
    Systemd_Filter    _SYSTEMD_UNIT={{ unit }}
{% endfor %}
    Systemd_Filter_Type or
    # Start at the tail: enabling this must not replay the whole backlog, which
    # Loki would mostly reject anyway (reject_old_samples_max_age: 168h).
    Read_From_Tail    On
    # Strip_Underscores stays OFF (default). Journal keys therefore keep their
    # leading underscore, so the accessors below are `$_HOSTNAME` etc. That is
    # intentional: stripping would produce a record key named HOSTNAME, which
    # collides in reading with the HOSTNAME env var this container also sets.
    # VERIFIED end-to-end on spark1 (arm64, fluent-bit 4.2 under podman against
    # a local HTTP sink, 2026-08-01): the underscored accessors resolve, and the
    # emitted stream was
    #   {"identifier":"k3s","job":"systemd-journal","node":"spark1",
    #    "priority":"6","unit":"k3s-agent.service"}
    # with the bare journal MESSAGE as the line. See FLUENTBIT_VALIDATE.md 6.8.
    DB                /var/log/flb_journal.db
    Max_Entries       {{ fluentbit_systemd_max_entries | default(1000) }}
    storage.type      filesystem

# A journal record carries 20+ fields. Keep only the message plus the four that
# become labels; everything else would end up serialized into the log line.
# After the [OUTPUT] below consumes the four as labels (out_loki removes every
# label accessor from the body), MESSAGE is the single remaining key, which is
# what makes `drop_single_key raw` emit the bare message.
[FILTER]
    Name          record_modifier
    Match         host.*
    Allowlist_key MESSAGE
    Allowlist_key _SYSTEMD_UNIT
    Allowlist_key _HOSTNAME
    Allowlist_key SYSLOG_IDENTIFIER
    Allowlist_key PRIORITY

{% endif %}
[FILTER]
    Name                kubernetes
    Match               kube.*
    Kube_Tag_Prefix     kube.var.log.containers.
    # Keep the log line raw — parsing it into fields would change what Loki
    # stores as the line body (see drop_single_key below).
    Merge_Log           Off
    Keep_Log            On
    Labels              On
    Annotations         Off
    K8S-Logging.Parser  Off
    K8S-Logging.Exclude On

# Builds the `job` label ("<namespace>/<pod>") on the record. MUST come after
# the kubernetes filter — that is what puts the metadata on the record.
#
# out_loki cannot do this itself: its `labels` option takes exactly ONE record
# accessor per value, so `job=$kubernetes['namespace_name']/$kubernetes['pod_name']`
# is rejected at startup ("bad input character '/'") and the plugin then
# SIGSEGVs in flb_loki_kv_destroy() on that error path. Verified the hard way on
# 4.2.7. promtail builds the same label with a relabel concat, which has no
# equivalent here, so it has to happen on the record. Details in
# files/fluentbit_job_label.lua.
[FILTER]
    Name    lua
    Match   kube.*
    script  /fluent-bit/etc/conf/fluentbit_job_label.lua
    call    set_job

[OUTPUT]
    Name                   loki
    Match                  kube.*
    Host                   loki.loki.svc.cluster.local
    Port                   3100
    #
    # Stream labels. Mapping back to the promtail relabel rules:
    #   job=<ns>/<pod>  ← replace(namespace, pod_name, separator '/'). Built on
    #     the RECORD by the lua filter above, then picked up here as `$job`.
    #     out_loki takes exactly ONE accessor per label value, so writing the
    #     concatenation inline here is a startup error plus a SIGSEGV.
    #   namespace / pod / container ← the three explicit replace rules.
    #   stream ← promtail's cri stage. Naming it here also drops it from the
    #     line body: out_loki appends every label accessor to its internal
    #     remove_keys list.
    #   pod labels ← the fluentbit_pod_labels allowlist. A label a pod does not
    #     carry is silently skipped rather than emitted empty (loki.c:421-431).
    #   __host__ was promtail-internal and never exported, hence no `node`
    #     label unless fluentbit_node_label is set.
    #
    # DELIBERATELY NOT reproduced: `filename`. promtail adds it for every file
    # target; the value embeds the container ID, so it churns on every restart
    # while job/pod/container already identify the source.
    #
    labels                 job=$job, namespace=$kubernetes['namespace_name'], pod=$kubernetes['pod_name'], container=$kubernetes['container_name'], stream=$stream
{%- if fluentbit_node_label | default(false) | bool %}, node=$kubernetes['host']
{%- endif %}
{%- if not (fluentbit_auto_kubernetes_labels | default(false) | bool) %}
{%- for label in fluentbit_pod_labels | default([]) %}, {{ label | regex_replace('[^a-zA-Z0-9_]', '_') }}=$kubernetes['labels']['{{ label }}']
{%- endfor %}
{%- endif %}

    # `on` = every pod label becomes a stream label, i.e. byte-exact promtail
    # parity including its cardinality churn (pod-template-hash alone measured
    # 31 distinct values across 32 pods here). Off by default; the allowlist
    # above is the curated replacement.
    auto_kubernetes_labels {{ 'on' if (fluentbit_auto_kubernetes_labels | default(false) | bool) else 'off' }}
{% if fluentbit_pod_labels_structured_metadata | default(true) | bool %}
    # The full pod-label map as structured metadata, so the churn labels that
    # were dropped from the allowlist stay findable without costing a stream:
    # `| pod_template_hash="abc"` after a stream selector instead of
    # `{pod_template_hash="abc"}`. Verified against out_loki's pack_maps(): it
    # walks the addressed map and packs one entry per label, sanitizing keys
    # the same way the stream labels are sanitized.
    structured_metadata_map_keys $kubernetes['labels']
{% endif %}
    # promtail ships the RAW log line; fluent-bit would ship
    # {"log":...,"stream":...,"time":...}. remove_keys strips everything but
    # `log`, then drop_single_key raw emits that value unquoted — byte-equal to
    # promtail, so existing substring and regex filters don't silently start
    # matching against JSON escaping.
    line_format            json
    # `_p` is the CRI multiline parser's partial-line marker (P/F). It MUST be
    # listed: drop_single_key only fires when exactly ONE key is left, so
    # leaving _p in place ships `{"_p":"F","log":"..."}` instead of the bare
    # line — verified locally, it does not show up in a config test.
    # kubernetes/time/stream/job are consumed by the labels above (out_loki
    # removes every label accessor from the body); kubernetes and time are
    # named explicitly because they are not label accessors.
    remove_keys            kubernetes,time,_p
    drop_single_key        raw
    compress               gzip
    # A Loki restart must not cost log lines, so retries are unlimited and the
    # backlog spills to disk. storage.total_limit_size bounds the damage if
    # Loki stays down: once hit, the OLDEST buffered chunks are dropped.
    retry_limit            false
    storage.total_limit_size {{ fluentbit_output_storage_limit | default('1G') }}
{% if fluentbit_systemd_enabled | default(false) | bool %}

# Journal records need their OWN output: the pod output above builds every
# label from `$kubernetes[...]`, which does not exist on a journal record. Those
# accessors would all resolve to nothing, out_loki would find zero labels and
# fall back to its built-in default `job=fluent-bit`, dumping the whole journal
# into one unlabelled stream.
#
# `job=systemd-journal` is a static value, so it is distinguishable at a glance
# from the pod streams, whose job is always `<namespace>/<pod>`. All four
# remaining labels are low-cardinality: 5 nodes, a bounded unit set, a bounded
# identifier set and 8 syslog priorities.
[OUTPUT]
    Name                   loki
    Match                  host.*
    Host                   loki.loki.svc.cluster.local
    Port                   3100
    labels                 job=systemd-journal, node=$_HOSTNAME, unit=$_SYSTEMD_UNIT, identifier=$SYSLOG_IDENTIFIER, priority=$PRIORITY
    line_format            json
    drop_single_key        raw
    compress               gzip
    retry_limit            false
    storage.total_limit_size {{ fluentbit_output_storage_limit | default('1G') }}
{% endif %}
