{# portmap masquerades HAProxy -> 127.0.0.1:hostPort to cni0, so the sender is in cluster_cidr; traefik-netpol.yaml locks out pods #}
{% set traefik_proxy_trusted_ips = [cluster_cidr] %}
---
# kubectl apply -f https://raw.githubusercontent.com/traefik/traefik/v3.6/docs/content/reference/dynamic-configuration/kubernetes-crd-rbac.yml
# kubectl apply -f https://raw.githubusercontent.com/traefik/traefik/v3.6/docs/content/reference/dynamic-configuration/kubernetes-crd-definition-v1.yml
#root@acerrevo ~ # kubectl apply -f https://raw.githubusercontent.com/traefik/traefik/v2.10/docs/content/reference/dynamic-configuration/kubernetes-crd-rbac.yml
#root@acerrevo ~ # kubectl apply -f https://raw.githubusercontent.com/traefik/traefik/v2.10/docs/content/reference/dynamic-configuration/kubernetes-crd-definition-v1.yml
# kubectl apply -f https://raw.githubusercontent.com/traefik/traefik/v2.11/docs/content/reference/dynamic-configuration/kubernetes-crd-rbac.yml
# root@argras1 /var/lib/rancher/k3s/server/manifests # cat traefik-extend.yaml
# KUBE_EDITOR=vim kubectl edit clusterroles traefik
# https://github.com/k3s-io/k3s/issues/8755
apiVersion: helm.cattle.io/v1
kind: HelmChartConfig
metadata:
  name: traefik
  namespace: kube-system
spec:
  valuesContent: |-
    deployment:
      replicas: 1
      # the chart uses ports.traefik.hostIP as probe host: without this port the kubelet probes 127.0.0.1:8080 on the node
      healthchecksPort: 30808
    updateStrategy:
      type: RollingUpdate
      rollingUpdate:
        # a surge pod can never get the hostPort on the same node -> rollout would hang
        maxSurge: 0
        maxUnavailable: 1
    affinity:
      podAntiAffinity:
        preferredDuringSchedulingIgnoredDuringExecution:
          - weight: 100
            podAffinityTerm:
              labelSelector:
                matchLabels:
                  app.kubernetes.io/name: traefik
              topologyKey: kubernetes.io/hostname
      nodeAffinity:
        requiredDuringSchedulingIgnoredDuringExecution:
          nodeSelectorTerms:
            - matchExpressions:
                - key: node-role
                  operator: In
                  values:
                    - k3smaster
    resources:
      requests:
        cpu: 100m
        memory: 128Mi
      limits:
        cpu: 500m
        memory: 512Mi
    logs:
      general:
        level: INFO
      access:
        enabled: true
        format: json  # common or json
    service:
      # HAProxy uses the hostPorts, Prometheus the pod SD
      enabled: false
    ingressRoute:
      dashboard:
        # -- Create an IngressRoute for the dashboard
        enabled: true
    #core:
    #  defaultRuleSyntax: v2
    dashboard.enabled: true
    api.dashboard: true
    # externalTrafficPolicy: local
    additionalArguments:
      - "--ping"
    ports:
      traefik:
        port: 8080
        exposedPort: 8080
        hostPort: 30808
        hostIP: 127.0.0.1
        expose:
          default: true
      web:
        port: 8181
        exposedPort: 8181
        hostPort: 30080
        hostIP: 127.0.0.1
        proxyProtocol:
          trustedIPs: {{ traefik_proxy_trusted_ips | to_json }}
          #trustedIPs: [ ]
          #  - <proxy-ip>
          #  - 127.0.0.1  # never matches: Traefik sees the sender masqueraded by portmap (cni0)
        # forwardedHeaders.insecure: true would let ANY peer claim an arbitrary client
        # IP via X-Forwarded-For. Use the explicit traefik_forwarded_trusted_ips
        # allowlist instead. Omitted entirely when the list is empty (the main/ dummy),
        # so a clone without the vault renders exactly the previous config: Traefik then
        # trusts nobody and overwrites X-Forwarded-For with the peer IP.
{% if traefik_forwarded_trusted_ips | default([]) | length > 0 %}
        forwardedHeaders:
          trustedIPs: {{ traefik_forwarded_trusted_ips | to_json }}
{% endif %}
      websecure:
        port: 4430
        exposedPort: 4430
        hostPort: 30443
        hostIP: 127.0.0.1
        proxyProtocol:
          trustedIPs: {{ traefik_proxy_trusted_ips | to_json }}
        # Same allowlist as web: without it Traefik discards the edge's X-Forwarded-For
        # and every remote client looks like the proxy IP to the backend.
{% if traefik_forwarded_trusted_ips | default([]) | length > 0 %}
        forwardedHeaders:
          trustedIPs: {{ traefik_forwarded_trusted_ips | to_json }}
{% endif %}
