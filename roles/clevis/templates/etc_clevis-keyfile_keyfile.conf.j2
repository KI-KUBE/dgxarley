# Managed by Ansible (clevis role), sourced by the clevis-keyfile initramfs hook and local-top script
KEYFILE={{ clevis_keyfile_path | quote }}
USB={{ 1 if (clevis_keyfile_usb_enabled | bool) else 0 }}
USB_LABEL={{ clevis_keyfile_usb_label | quote }}
USB_FILE={{ clevis_keyfile_usb_file | quote }}
USB_DIR={{ clevis_keyfile_usb_dir | default('') | regex_replace('^/+|/+$', '') | quote }}
HOST={{ inventory_hostname | quote }}
BOOT={{ 1 if (clevis_put_keyfile_to_boot_partition_enabled | bool) else 0 }}
BOOT_DEV={{ ('UUID=' ~ clevis_boot_uuid) | quote if (clevis_put_keyfile_to_boot_partition_enabled | bool) else "''" }}
BOOT_FILE={{ clevis_keyfile_boot_file | regex_replace('^/+', '') | quote }}
