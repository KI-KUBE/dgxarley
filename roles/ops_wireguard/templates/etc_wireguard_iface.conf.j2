# Managed by Ansible (roles/ops_wireguard) - local edits are overwritten.
# No secret in this file: the private key is loaded from {{ _ops_wireguard.private_key_file }} by PostUp.
# Forwarding/NAT for the ops subnet is NOT done here but in the common firewall (iptables.sh.j2).
# route_mode {{ _ops_wireguard.route_mode }}.{% if _ops_wireguard.route_mode == 'source' %} source: the ops route lives in table {{ _ops_wireguard.route_table }}, used only for packets sourced from
# the tunnel address (ip rule). Without it a node that is also reachable via another path (e.g. a Mikrotik
# tunnel) would answer LAN-originated flows through THIS tunnel; the hub drops them (asymmetric routing).{% endif %}

[Interface]
Address = {{ _ops_wireguard.tunnel_address }}
{% if _ops_wireguard.route_mode == 'source' %}
Table = {{ _ops_wireguard.route_table }}
PostUp = ip -4 rule add from {{ _ops_wireguard.tunnel_address.split('/')[0] }} lookup {{ _ops_wireguard.route_table }} priority {{ _ops_wireguard.rule_priority }}
PostDown = ip -4 rule del from {{ _ops_wireguard.tunnel_address.split('/')[0] }} lookup {{ _ops_wireguard.route_table }} priority {{ _ops_wireguard.rule_priority }}
{% endif %}
PostUp = wg set %i private-key {{ _ops_wireguard.private_key_file }}

[Peer]
PublicKey = {{ _ops_wireguard.hub_public_key }}
Endpoint = {{ _ops_wireguard.hub_endpoint }}
AllowedIPs = {{ _ops_wireguard.ops_subnet }}
PersistentKeepalive = {{ _ops_wireguard.keepalive }}
